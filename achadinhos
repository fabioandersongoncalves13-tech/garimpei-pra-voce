<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080306">
  <meta name="description" content="Garimpei Pra Você — achadinhos, ofertas e produtos que valem a pena.">
  <title>Garimpei Pra Você | Links</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #080306;
      --card: rgba(28, 2, 9, .72);
      --border: rgba(255, 34, 72, .42);
      --red: #ff2148;
      --red-soft: #b81635;
      --text: #fff;
      --muted: #a87580;
    }

    body {
      min-height: 100vh;
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
                   "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 50% 15%, rgba(125, 0, 28, .25), transparent 34%),
        radial-gradient(circle at 15% 75%, rgba(85, 0, 20, .16), transparent 30%),
        var(--bg);
      overflow-x: hidden;
    }

    /* Fundo com partículas e conexões */
    .background {
      position: fixed;
      inset: 0;
      z-index: -1;
      overflow: hidden;
      pointer-events: none;
      opacity: .8;
    }

    .line {
      position: absolute;
      height: 1px;
      transform-origin: left center;
      background: linear-gradient(90deg, transparent, rgba(255, 24, 66, .34), transparent);
      box-shadow: 0 0 8px rgba(255, 24, 66, .15);
    }

    .dot {
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: #ff1745;
      box-shadow: 0 0 13px #ff1745;
      animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: .25; transform: scale(.8); }
      50% { opacity: .95; transform: scale(1.25); }
    }

    .container {
      width: min(100% - 32px, 560px);
      margin: 0 auto;
      padding: 48px 0 35px;
    }

    header {
      text-align: center;
      margin-bottom: 34px;
    }

    .avatar {
      width: 92px;
      height: 92px;
      margin: 0 auto 18px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 33, 72, .65);
      background: linear-gradient(145deg, #2b0610, #100207);
      box-shadow:
        0 0 0 6px rgba(255, 33, 72, .04),
        0 0 35px rgba(255, 20, 64, .18);
      font-size: 40px;
    }

    h1 {
      font-size: clamp(25px, 6vw, 34px);
      font-weight: 800;
      letter-spacing: -.8px;
    }

    .tagline {
      margin-top: 8px;
      color: var(--muted);
      font-size: 14px;
    }

    .links-label {
      text-align: center;
      margin-bottom: 15px;
      color: #8e5260;
      font-size: 10px;
      letter-spacing: 7px;
      text-transform: uppercase;
    }

    .links {
      display: grid;
      gap: 14px;
    }

    .link {
      position: relative;
      min-height: 82px;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 15px 19px;
      text-decoration: none;
      color: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      background: linear-gradient(100deg, rgba(40, 3, 12, .88), rgba(16, 2, 7, .73));
      box-shadow: inset 0 0 22px rgba(255, 0, 47, .025);
      overflow: hidden;
      transition: transform .22s ease, border-color .22s ease,
                  box-shadow .22s ease, background .22s ease;
    }

    .link::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(100deg, transparent, rgba(255, 30, 70, .09), transparent);
      transform: translateX(-100%);
      transition: transform .55s ease;
    }

    .link:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 33, 72, .85);
      box-shadow: 0 12px 35px rgba(130, 0, 30, .18);
    }

    .link:hover::before {
      transform: translateX(100%);
    }

    .icon {
      flex: 0 0 50px;
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 33, 72, .38);
      border-radius: 15px;
      background: rgba(70, 4, 18, .45);
      color: #ff4665;
    }

    .icon svg {
      width: 25px;
      height: 25px;
      fill: currentColor;
    }

    .info {
      min-width: 0;
      flex: 1;
    }

    .title {
      font-size: 17px;
      font-weight: 750;
      line-height: 1.15;
    }

    .description {
      margin-top: 5px;
      color: #8e5360;
      font-size: 12px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .arrow {
      color: #8d293b;
      font-size: 25px;
      line-height: 1;
      transition: transform .2s ease, color .2s ease;
    }

    .link:hover .arrow {
      color: #ff3155;
      transform: translateX(4px);
    }

    /* Destaque */
    .featured {
      border-color: rgba(255, 33, 72, .68);
      background:
        linear-gradient(100deg, rgba(82, 5, 22, .82), rgba(25, 2, 9, .82));
      box-shadow: 0 0 28px rgba(255, 20, 60, .08);
    }

    .badge {
      position: absolute;
      top: 9px;
      right: 13px;
      padding: 4px 8px;
      border-radius: 20px;
      background: #ff2148;
      color: white;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: .8px;
      text-transform: uppercase;
    }

    footer {
      text-align: center;
      margin-top: 32px;
      color: #60333d;
      font-size: 11px;
    }

    footer strong {
      color: #8d4654;
    }

    @media (max-width: 480px) {
      .container {
        width: min(100% - 22px, 560px);
        padding-top: 30px;
      }

      header {
        margin-bottom: 28px;
      }

      .avatar {
        width: 82px;
        height: 82px;
        font-size: 34px;
      }

      .link {
        min-height: 76px;
        padding: 13px 15px;
        border-radius: 17px;
      }

      .icon {
        width: 46px;
        height: 46px;
        flex-basis: 46px;
      }
    }
  </style>
</head>

<body>
