    <footer>
      Feito para <strong>Garimpei Pra Você</strong> • © 2026
    </footer>
  </main>

  <script>
    (function () {
      var DAY_MS = 24 * 60 * 60 * 1000;
      var EXPIRE_DAYS = 7; // quantos dias uma oferta fica no ar

      document.querySelectorAll('.link[data-added]').forEach(function (link) {
        var added = new Date(link.dataset.added + 'T00:00:00');
        if (isNaN(added.getTime())) return;

        var expires = new Date(added.getTime() + EXPIRE_DAYS * DAY_MS);
        var now = new Date();
        var msLeft = expires - now;

        if (msLeft <= 0) {
          link.remove();
          return;
        }

        var daysLeft = Math.max(1, Math.ceil(msLeft / DAY_MS));
        var badge = link.querySelector('[data-badge]');
        if (badge) {
          badge.textContent = daysLeft === 1 ? 'Último dia' : daysLeft + ' dias';
        }
      });

      // Se todas as ofertas com prazo expiraram, mostra um aviso
      var remaining = document.querySelectorAll('.links .link[data-added]').length;
      if (remaining === 0) {
        var label = document.querySelector('.links-label');
        if (label) {
          var notice = document.createElement('p');
          notice.textContent = 'Sem ofertas no momento — volte em breve! 🔎';
          notice.style.textAlign = 'center';
          notice.style.color = '#a87580';
          notice.style.fontSize = '13px';
          notice.style.marginBottom = '20px';
          label.insertAdjacentElement('afterend', notice);
        }
      }
    })();
  </script>
</body>
</html>
